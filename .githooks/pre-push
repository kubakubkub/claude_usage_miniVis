#!/bin/sh
# Blocks a push that would publish secrets or personal data. See check_private.py.
# Enable once per clone:  git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
for py in "$root/.venv/Scripts/python.exe" "$root/.venv/bin/python" python3 python; do
  # Actually run it: on Windows `python3` can be a Microsoft Store stub that
  # exists on PATH but only prints an install hint.
  if "$py" -c "import sys" </dev/null >/dev/null 2>&1; then
    exec "$py" "$root/check_private.py" --pre-push
  fi
done
echo "pre-push: no Python found to run check_private.py -- push blocked." >&2
exit 1
